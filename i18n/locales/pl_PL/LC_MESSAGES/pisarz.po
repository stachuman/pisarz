msgstr "Nie udało się załadować projektów: {}"

msgid "Failed to load scenes: {}"
msgstr "Nie udało się załadować scen: {}"

msgid "Failed to open scene: {}"
msgstr "Nie udało się otworzyć scenę: {}"

msgid "Failed to save scene: {}"
msgstr "Nie udało się zapisać sceny: {}"

msgid "Failed to create project: {}"
msgstr "Nie udało się stworzyć projektu: {}"

msgid "Failed to create scene: {}"
msgstr "Nie udało się stworzyć sceny: {}"

msgid "Failed to load view: {}"
msgstr "Nie udało się załadować widoku: {}"

msgid "Scene saved successfully"
msgstr "Scena zapisana pomyślnie"

msgid "Failed to save scene"
msgstr "Błąd zapisywania sceny"

msgid "Project name:"
msgstr "Nazwa projektu:"

msgid "Scene title:"
msgstr "Tytuł sceny:"

msgid "Created project: {}"
msgstr "Stworzono projekt: {}"

msgid "Created scene: {}"
msgstr "Stworzono scenę: {}"

msgid "Project: {} ({} scenes)"
msgstr "Projekt: {} ({} scen)"

msgid "Scenes view ({} scenes)"
msgstr "Widok scen ({} scen)"

msgid "Editing scene: {}"
msgstr "Edytujesz scenę: {}"

msgid "Applied theme: {}"
msgstr "Zastosowano motyw: {}"

msgid "View {} (function unavailable)"
msgstr "Widok {} (funkcja niedostępna)"

msgid "Projects list ({} projects)"
msgstr "Lista projektów ({} projektów)"

# Language Settings
msgid "Language"
msgstr "Język"

msgid "Choose language:"
msgstr "Wybierz język:"

msgid "Language Changed"
msgstr "Język Zmieniony"

msgid "Language has been changed. Please restart the application to see changes."
msgstr "Język został zmieniony. Proszę zrestartować aplikację aby zobaczyć zmiany."